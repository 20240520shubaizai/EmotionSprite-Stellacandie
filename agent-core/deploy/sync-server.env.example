# Formal cloud mode refuses SQLite. Replace host/user/password and require TLS.
SYNC_DEPLOYMENT_MODE=cloud_mysql
SYNC_DATABASE_URL=mysql+pymysql://emotion_sync_app:REPLACE_ME@mysql.example.com:3306/emotion_sprite_sync?charset=utf8mb4&ssl_ca=C%3A%2Fcerts%2Fca.pem
AGENT_SESSION_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE
AGENT_MODEL_MODE=real
