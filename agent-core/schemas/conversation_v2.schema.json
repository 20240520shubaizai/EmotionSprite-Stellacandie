{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.emotionsprite/schemas/conversation_v2.schema.json",
  "title": "EmotionSprite conversation_v2 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "text", "current_time", "conversation_context", "persona_context", "pet_state", "privacy", "allowed_mutations"],
  "properties": {
    "schema_version": {"const": "conversation_v2"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "current_time": {"type": "string", "format": "date-time"},
    "conversation_context": {"type": "array", "maxItems": 20, "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"enum": ["user", "assistant"]}, "content": {"type": "string", "maxLength": 4000}, "created_at": {"type": "string"}}}},
    "persona_context": {"type": "string", "maxLength": 16000},
    "pet_state": {"type": "object", "additionalProperties": {"type": "integer"}},
    "privacy": {"type": "object", "required": ["allow_memory", "allow_secret", "allow_cloud_sync"], "properties": {"allow_memory": {"type": "boolean"}, "allow_secret": {"type": "boolean"}, "allow_cloud_sync": {"type": "boolean"}}},
    "allowed_mutations": {"type": "array", "items": {"enum": ["memory_candidate", "reminder", "state_delta"]}, "uniqueItems": true},
    "attachment": {"type": ["object", "null"], "properties": {"name": {"type": "string"}, "kind": {"const": "image_description"}}}
  }
}
